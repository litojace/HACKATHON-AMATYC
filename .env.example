# Leave both empty for clearly labeled demonstration mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional canonical public origin for email, password recovery and OAuth redirects.
# Set this to your deployed site when users confirm email on another device.
NEXT_PUBLIC_SITE_URL=
# Used only by trusted seed/import scripts; never exposed to browsers.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only key preserving signed demo sessions across restarts.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DEMO_SESSION_SECRET=
